# Copy to .env.public (ignored). Never put a private key or Tunnel token here.
AUTH_PUBLIC_URL=https://mbtracer.yellowtail.work
FIREBASE_PROJECT_ID=mobile-tracer-2d1e3
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=mobile-tracer-2d1e3.firebaseapp.com
FIREBASE_APP_ID=1:693779135001:web:fc5d21766493a9fea98888
AUTH_SESSION_TTL=120h
SYSTEM_ADMIN_EMAILS=
# Use ignored secrets/ or external files; owned by PUBLIC_UID, mode 600.
# Example: ./secrets/firebase-admin.json and ./secrets/tunnel-token
FIREBASE_CREDENTIALS_FILE=
CLOUDFLARE_TUNNEL_TOKEN_FILE=
# Set to the output of id -u / id -g for the account owning the secret files.
PUBLIC_UID=1000
PUBLIC_GID=1000
# Change all three if this subnet overlaps an existing network.
# Keep the fixed proxy IP outside the dynamic allocation range.
PUBLIC_APP_SUBNET=172.30.72.0/24
PUBLIC_APP_IP_RANGE=172.30.72.128/25
PUBLIC_PROXY_IP=172.30.72.2
# Use separate passwords and volumes from development.
POSTGRES_DB=mobile_tracer
POSTGRES_USER=mobiletracer
POSTGRES_PASSWORD=
TAPYRUS_RPC_USER=mobiletracer
TAPYRUS_RPC_PASSWORD=
TAPYRUS_NETWORK_ID=1905960821
TAPYRUS_WALLET=mobile-tracer

# Chaintope Tapyrus API (Timestamp V2). Empty URL disables external registration.
# Place PEM certificate/key and token in this dedicated directory, not in Git.
TAPYRUS_API_URL=
TAPYRUS_API_SECRETS_DIR=./secrets/tapyrus-api
# Set the paths below only when enabling the API:
# TAPYRUS_API_TOKEN_FILE=/run/tapyrus-api/token
# TAPYRUS_API_CERT_FILE=/run/tapyrus-api/client.crt
# TAPYRUS_API_KEY_FILE=/run/tapyrus-api/client.key
TAPYRUS_API_TOKEN_FILE=
TAPYRUS_API_CERT_FILE=
TAPYRUS_API_KEY_FILE=
TAPYRUS_API_CA_FILE=
TAPYRUS_API_TIMEOUT=10s
