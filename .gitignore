# Documentation toolchain (PDF deliverables are tracked).
/.venv-docs/
__pycache__/
*.pyc
/docs/.build.lock
/docs/.design-*.tmp
/docs/quality/.traceability-*.tmp
/.cache-docs/
/scripts/slides/node_modules/
/docs/.slides.lock
/docs/.slides-*.tmp
/.env
/.env.public
/backups/
/secrets/
**/*firebase-admin*.json
**/*service-account*.json
**/tunnel-token*

# Firebase emulator logs and local state; service account credentials stay outside the repository.
/firebase-debug.log
/firebase-debug.*.log
/auth-debug.log
/.firebase/

# Isolated load test runtime files
/.env.load
/load/state/
/load/results/
/load/credentials/
