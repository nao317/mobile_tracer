# Local dev network only. scripts/init.sh generates passwords when empty.
TAPYRUS_NETWORK_ID=1905960821
TAPYRUS_RPC_USER=mobiletracer
TAPYRUS_RPC_PASSWORD=
TAPYRUS_WALLET=mobile-tracer
TAPYRUS_TIMEOUT=5s
NGINX_PORT=8080
BACKEND_DEBUG_PORT=8081
FRONTEND_DEBUG_PORT=3000
POSTGRES_DB=mobile_tracer
POSTGRES_USER=mobiletracer
POSTGRES_PASSWORD=
DB_PORT=5432
DB_TIMEOUT=3s
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
# Business API authentication is disabled until explicitly enabled for local development.
APP_ENV=production
DEV_AUTH_TOKEN=
DEV_AUTH_STAFF_ID=
# Firebase Authentication: enable Email/Password and Google in the Firebase console.
# Values below are public Web app configuration, not service account credentials.
# Local HTTP requires APP_ENV=development and a loopback AUTH_PUBLIC_URL.
AUTH_PUBLIC_URL=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Default 120h; Firebase allows 5m through 336h.
AUTH_SESSION_TTL=
SYSTEM_ADMIN_EMAILS=
# Server credentials: use ADC or compose.firebase.yaml with this untracked JSON file.
FIREBASE_CREDENTIALS_FILE=
# Development emulator only. Production startup rejects these settings.
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_URL=

# Chaintope Tapyrus API (Timestamp V2). Empty URL disables external registration.
# Place PEM certificate/key and token in this dedicated directory, not in Git.
# Set BACKEND_UID/BACKEND_GID to id -u/id -g so local containers can read 0600 files.
BACKEND_UID=1000
BACKEND_GID=1000
TAPYRUS_API_URL=
TAPYRUS_API_SECRETS_DIR=./secrets/tapyrus-api
# Set the paths below only when enabling the API:
# TAPYRUS_API_TOKEN_FILE=/run/tapyrus-api/token
# TAPYRUS_API_CERT_FILE=/run/tapyrus-api/client.crt
# TAPYRUS_API_KEY_FILE=/run/tapyrus-api/client.key
TAPYRUS_API_TOKEN_FILE=
TAPYRUS_API_CERT_FILE=
TAPYRUS_API_KEY_FILE=
TAPYRUS_API_CA_FILE=
TAPYRUS_API_TIMEOUT=10s
# Server-side Geoapify key used for place search and static map previews.
# The free plan requires attribution and currently includes 3,000 credits/day.
GEOAPIFY_API_KEY=
